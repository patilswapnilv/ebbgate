# Copy to examples/compose/.env before `docker compose up`.

PAPERCLIP_API_KEY=sk_pap_change_me
EG_PAPERCLIP_SECRET=compose-shared-secret-change-me
EG_NODE_MINI_TOKEN=compose-mini-token-change-me

# Required: every LiteLLM request must send this key (must start with sk-).
LITELLM_MASTER_KEY=sk-litellm-change-me

# Optional — used by LiteLLM cloud model placeholders
OPENAI_API_KEY=
