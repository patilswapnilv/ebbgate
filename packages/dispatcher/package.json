{
  "name": "@ebbgate/dispatcher",
  "version": "0.0.0",
  "private": true,
  "description": "Ebbgate dispatcher: presence-aware Paperclip task router.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "ebbgate-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./demo": {
      "ebbgate-source": "./src/demo-scenario.ts",
      "types": "./dist/demo-scenario.d.ts",
      "import": "./dist/demo-scenario.js"
    },
    "./start": {
      "ebbgate-source": "./src/start.ts",
      "types": "./dist/start.d.ts",
      "import": "./dist/start.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/demo-scenario.ts src/start.ts --format esm --clean --external better-sqlite3 --external @ebbgate/core --external pino && tsc -p tsconfig.build.json && mkdir -p dist/migrations && cp src/db/migrations/*.sql dist/migrations/",
    "typecheck": "tsc --noEmit -p .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@ebbgate/core": "workspace:*",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.12.7",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
