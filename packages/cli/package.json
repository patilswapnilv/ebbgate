{
  "name": "ebbgate",
  "version": "0.1.0",
  "description": "Presence-aware task handover for AI agents: local when your machine is on, cloud when it's not, private work waits at the gate.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "ai-agents",
    "paperclip",
    "ollama",
    "litellm",
    "local-first",
    "privacy",
    "self-hosted",
    "dispatcher",
    "presence"
  ],
  "homepage": "https://github.com/patilswapnilv/ebbgate#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/patilswapnilv/ebbgate.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/patilswapnilv/ebbgate/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "ebbgate": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "ebbgate-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --clean --no-splitting && tsc -p tsconfig.build.json && mkdir -p dist/migrations && cp ../dispatcher/src/db/migrations/*.sql dist/migrations/",
    "typecheck": "tsc --noEmit -p .",
    "prepack": "cp ../../README.md ../../LICENSE ."
  },
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "better-sqlite3": "^12.6.2",
    "hono": "^4.12.7",
    "pino": "^10.3.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ebbgate/agent": "workspace:*",
    "@ebbgate/core": "workspace:*",
    "@ebbgate/dispatcher": "workspace:*"
  }
}
